<Project Sdk="Microsoft.NET.Sdk">
  <!-- Glasspen Meet for Windows: WPF written in C# only (no XAML). Build on Windows with
       `dotnet publish -c Release` (see windows/README.md). EnableWindowsTargeting also lets
       macOS/Linux compile-check it, but it only runs on Windows 10 1809 or later. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GlasspenMeet</AssemblyName>
    <RootNamespace>Glasspen.Windows</RootNamespace>
    <Product>Glasspen Meet</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\glasspen.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010 is a Windows Forms hint; this is a WPF app, which takes its DPI mode from app.manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- One self-contained GlasspenMeet.exe: no .NET install needed on the user's PC. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Glasspen.Core\Glasspen.Core.csproj" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Makaretu.Dns.Multicast.New" Version="0.31.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\glasspen.ico" />
  </ItemGroup>
</Project>
